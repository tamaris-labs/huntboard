# Copiez ce fichier en .env et complétez-le. Le fichier .env n'est jamais versionné.

# --- Accès à l'interface ---------------------------------------------------
# Mot de passe demandé par le navigateur (authentification HTTP simple).
# Indispensable si l'application est accessible depuis Internet.
APP_PASSWORD=
HUNTBOARD_PORT=8000
TZ=Europe/Paris

# --- Modèle de langage -----------------------------------------------------
# anthropic (recommandé, recherche web intégrée) ou openai (toute API compatible OpenAI)
LLM_PROVIDER=anthropic
LLM_API_KEY=
# Pour LLM_PROVIDER=openai uniquement :
#   OpenAI : laisser vide
#   Gemini : https://generativelanguage.googleapis.com/v1beta/openai/
#   Ollama : http://host.docker.internal:11434/v1
LLM_BASE_URL=
# Modèles par niveau : rapide (extraction), standard (conversation), avancé (notation, entretiens)
LLM_MODEL_QUICK=claude-haiku-5-5
LLM_MODEL_DEFAULT=claude-sonnet-5-5
LLM_MODEL_COMPLEX=claude-opus-5-5
# Nombre maximal de recherches web par passage (0,01 $ par recherche avec l'API Claude)
WEB_SEARCH_MAX_USES=15

# --- Veille planifiée ------------------------------------------------------
VEILLE_ENABLED=true
# Format cron : minute heure jour mois jour_semaine (ici 8 h 30 du lundi au vendredi)
VEILLE_CRON=30 8 * * 1-5

# --- Alertes e-mail (lecture seule, IMAP) ----------------------------------
# Gmail : imap.gmail.com, avec un mot de passe d'application (compte Google > Sécurité)
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
ALERT_SENDERS=jobalerts-noreply@linkedin.com,jobs-noreply@linkedin.com,emails.hellowork.com,michaelpage

# --- Notification du résumé quotidien ---------------------------------------
# Par exemple un sujet ntfy (application Android ou iOS) : https://ntfy.sh/mon-sujet-secret
NOTIFY_URL=

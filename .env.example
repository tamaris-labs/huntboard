# Copiez ce fichier en .env et complétez-le. Le fichier .env n'est jamais versionné.

# --- Accès à l'interface ---------------------------------------------------
# Mot de passe demandé par le navigateur (authentification HTTP simple).
# Indispensable si l'application est accessible depuis Internet.
APP_PASSWORD=
HUNTBOARD_PORT=8000
TZ=Europe/Paris

# --- Modèle de langage -----------------------------------------------------
# anthropic (recommandé) ou openai (toute API compatible OpenAI). Exemples complets : docs/fr/moteurs-ia.md (EN : docs/en/ai-engines.md)
LLM_PROVIDER=anthropic
LLM_API_KEY=
# Pour LLM_PROVIDER=openai uniquement :
#   OpenAI     : laisser vide
#   Gemini     : https://generativelanguage.googleapis.com/v1beta/openai/
#   Mistral    : https://api.mistral.ai/v1
#   Grok (xAI) : https://api.x.ai/v1
#   OpenRouter : https://openrouter.ai/api/v1
#   DeepSeek   : https://api.deepseek.com/v1
#   Ollama     : http://host.docker.internal:11434/v1
#   LM Studio  : http://host.docker.internal:1234/v1
LLM_BASE_URL=
# Modèles par niveau : rapide (extraction), standard (conversation), avancé (notation, entretiens)
LLM_MODEL_QUICK=claude-haiku-5-5
LLM_MODEL_DEFAULT=claude-sonnet-5-5
LLM_MODEL_COMPLEX=claude-opus-5-5
# --- Recherche web (veille et suggestions de sources) ---------------------
# auto   : recherche intégrée du fournisseur (Claude, OpenAI, Gemini, Grok, OpenRouter),
#          sinon SearXNG ou Brave/Tavily si renseignés ci-dessous, sinon aucune
# native : recherche du fournisseur uniquement
# brave | tavily : service externe avec clé (SEARCH_API_KEY), utilisable avec tout modèle
# searxng : moteur auto-hébergé (SEARXNG_URL), gratuit, voir deploy/docker-compose.searxng.yml
# none   : pas de recherche web (lecture des pages des sources et des alertes e-mail)
WEB_SEARCH=auto
SEARCH_API_KEY=
SEARXNG_URL=
# Nombre maximal de recherches web par passage (0,01 $ par recherche avec l'API Claude)
WEB_SEARCH_MAX_USES=15

# --- Veille planifiée ------------------------------------------------------
VEILLE_ENABLED=true
# Format cron : minute heure jour mois jour_semaine (ici 8 h 30 du lundi au vendredi)
VEILLE_CRON=30 8 * * 1-5

# --- Alertes e-mail (lecture seule, IMAP) ----------------------------------
# Gmail : imap.gmail.com, avec un mot de passe d'application (compte Google > Sécurité)
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
ALERT_SENDERS=jobalerts-noreply@linkedin.com,jobs-noreply@linkedin.com,emails.hellowork.com,michaelpage

# --- Notification du résumé quotidien ---------------------------------------
# Par exemple un sujet ntfy (application Android ou iOS) : https://ntfy.sh/mon-sujet-secret
NOTIFY_URL=
